#: ../../../deprecated/distutils/setupscript.rst:422
msgid "``mypkg``"
msgstr ""

#: ../../../deprecated/distutils/setupscript.rst:422
msgid "Provide ``mypkg``, using the distribution version"
msgstr ""

#: ../../../deprecated/distutils/setupscript.rst:425
msgid "``mypkg (1.1)``"
msgstr ""

#: ../../../deprecated/distutils/setupscript.rst:425
msgid "Provide ``mypkg`` version 1.1, regardless of the distribution version"

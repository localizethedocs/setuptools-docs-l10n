msgstr ""

#: ../../../../NEWS (links).rst:7761
msgid "Fixed ``--allow-hosts`` option blocking ``file:`` URLs"
msgstr ""

#: ../../../../NEWS (links).rst:7763
msgid ""
"Fixed HTTP SVN detection failing when the page title included a project name "
